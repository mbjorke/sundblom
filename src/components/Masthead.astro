---
interface Props {
  dateLabel: string;
  centerText?: string;
  rightText?: string;
}

const {
  dateLabel,
  centerText = '✦ \u00a0 AI-tolkning af Julius Sundblom · originalet från Ålands Radio \u00a0 ✦',
  rightText = 'Pris: 10 penni',
} = Astro.props;
---
<header class="masthead" role="banner">
  <p class="masthead-eyebrow">Grundad anno domini 1891</p>
  <h1 class="masthead-title">Åland igår och idag</h1>
  <p class="masthead-subtitle">Julius Sundblom tolkar · Ålands Radio berättar</p>
  <div class="masthead-rule"></div>
  <div class="masthead-dateline">
    <span>{dateLabel}</span>
    <span set:html={centerText} />
    <span>{rightText}</span>
  </div>
</header>

<style>
  .masthead {
    text-align: center;
    padding: 2rem 2.5rem 0;
    border-bottom: 4px double var(--rule);
  }
  .masthead-eyebrow {
    font-family: 'IM Fell English SC', serif;
    font-size: .85rem; letter-spacing: .25em;
    color: var(--muted); text-transform: uppercase; margin-bottom: .5rem;
  }
  .masthead-title {
    font-family: 'UnifrakturMaguntia', cursive;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1; margin-bottom: .2rem;
  }
  .masthead-subtitle {
    font-family: 'IM Fell English SC', serif;
    font-size: .85rem; letter-spacing: .3em;
    color: var(--muted); margin-bottom: .8rem;
  }
  .masthead-rule { height: 1px; background: var(--rule); margin: .4rem 0; }
  .masthead-dateline {
    display: flex; justify-content: space-between;
    padding: .4rem 0 .6rem;
    font-size: .85rem; color: var(--muted); font-style: italic;
  }

  @media (max-width: 640px) {
    .masthead { padding-left: 1.2rem; padding-right: 1.2rem; }
  }
</style>
